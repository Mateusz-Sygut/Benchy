  "help": {
    "intro": "Krótkie odpowiedzi, jak działa ŁawAppka.",
    "faq": {
      "addBench": {
        "q": "Jak dodać ławkę?",
        "a": "Otwórz prawy panel na mapie lub przejdź do Dodaj ławkę. Ustaw lokalizację przez GPS albo dotykając mapę, potem uzupełnij opis, typ i tagi."
      },
      "rate": {
        "q": "Jak ocenić ławkę?",
        "a": "Otwórz ławkę z mapy lub listy, a następnie wystaw gwiazdki i opcjonalny komentarz na ekranie szczegółów."
      },
      "titles": {
        "q": "Jak działają tytuły?",
        "a": "Tytuły odblokowujesz przez grę — dodawanie ławek, seria logowań i inne. W profilu zobaczysz odblokowane tytuły; dotknij, żeby ustawić aktywny."
      },
      "streak": {
        "q": "Co to seria logowań?",
        "a": "Wchodź do aplikacji kolejne dni z rzędu, żeby budować serię. Dłuższa seria odblokowuje osiągnięcia i tytuł Legenda."
      },
      "favorites": {
        "q": "Jak działają ulubione?",
        "a": "Dotknij serca przy ławce, żeby ją zapisać. Użyj filtra ulubionych na mapie albo wejdź w Ulubione z prawego panelu."
      },
      "tasks": {
        "q": "Czym są zadania w panelu użytkownika?",
        "a": "To krótka lista onboardingowa w trzech etapach. Ukończ wszystkie zadania z etapu, żeby zobaczyć następny. Wykonane zadania są odhaczone i prowadzą do odpowiedniego ekranu."
      },
      "sit": {
        "q": "Jak działa siadanie na ławce?",
        "a": "Otwórz ławkę i wybierz Usiądź, gdy jesteś w odległości ok. 80 m. Timer działa, dopóki jesteś w pobliżu. Sesje od 2 minut liczą się do osiągnięć; suma czasu siedzenia jest w profilu."
      }
    }
  },
